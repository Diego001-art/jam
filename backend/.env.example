# Только имена переменных — без секретов.
PORT=8787
DB_FILE=backend/data/app.db
# Адрес сайта: куда вести, если оффер не найден
SITE_URL=https://diego001-art.github.io/jam/
# Хэш пароля админки: npm run backend:hash -- "пароль не короче 12 символов"
ADMIN_PASSWORD_HASH=
# 1 — когда админка открыта по https (cookie только по защищённому каналу)
COOKIE_SECURE=0
# Уведомления о проблемах с офферами (npm run backend:check). Без них — только вывод в консоль.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK_URL=
# 1 — проверять и партнёрские ссылки (может засчитываться сетью как клик; включать, только если сеть разрешает)
CHECK_TRACKING=0
