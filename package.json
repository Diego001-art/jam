{
  "name": "credit-seo-project",
  "version": "1.0.0",
  "private": true,
  "description": "SEO-сайт подбора кредитных предложений (статическая сборка Next.js)",
  "scripts": {
    "dev": "next dev",
    "validate": "tsx scripts/validate-content.ts",
    "vendor": "node scripts/copy-vendor.mjs",
    "prebuild": "npm run vendor && npm run validate",
    "build": "next build",
    "postbuild": "tsx scripts/build-sitemap.ts --check",
    "test": "vitest run",
    "backend": "tsx backend/src/server.ts",
    "backend:hash": "tsx backend/src/hash-password.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fontsource/onest": "5.2.5",
    "gsap": "3.12.5",
    "next": "15.5.29",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.29",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
